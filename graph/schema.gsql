// TigerGraph Schema for IEEE-CIS Fraud Detection Dataset

CREATE VERTEX Transaction (
    PRIMARY_ID transaction_id STRING, 
    transaction_dt INT, 
    transaction_amt DOUBLE, 
    product_cd STRING, 
    card1 STRING, 
    card2 STRING, 
    card3 STRING, 
    card4 STRING, 
    card5 STRING, 
    card6 STRING, 
    addr1 STRING, 
    addr2 STRING, 
    dist1 DOUBLE, 
    dist2 DOUBLE, 
    p_emaildomain STRING, 
    r_emaildomain STRING, 
    is_fraud BOOL // Optional label if known
) WITH primary_id_as_attribute="true"

CREATE VERTEX Device (
    PRIMARY_ID device_id STRING, 
    device_type STRING, 
    device_info STRING
) WITH primary_id_as_attribute="true"

CREATE VERTEX IPAddress (
    PRIMARY_ID ip_address STRING
) WITH primary_id_as_attribute="true"

CREATE VERTEX Customer (
    PRIMARY_ID customer_id STRING,
    email STRING
) WITH primary_id_as_attribute="true"

// Relationships
CREATE DIRECTED EDGE HAS_DEVICE (FROM Transaction, TO Device)
CREATE DIRECTED EDGE FROM_IP (FROM Transaction, TO IPAddress)
CREATE DIRECTED EDGE MADE_TRANSACTION (FROM Customer, TO Transaction)
CREATE DIRECTED EDGE SHARES_DEVICE (FROM Customer, TO Device)

// Graph Creation
CREATE GRAPH FraudGraph(Transaction, Device, IPAddress, Customer, HAS_DEVICE, FROM_IP, MADE_TRANSACTION, SHARES_DEVICE)
