// TigerGraph Data Loading Job for HHGOA_IEEE Dataset

USE GRAPH FraudGraph

CREATE LOADING JOB load_fraud_data FOR GRAPH FraudGraph {
    
    // Define the file paths (These paths can be updated once the CSVs are in the data/ folder)
    DEFINE FILENAME transactions_file = "./data/transactions.csv";
    DEFINE FILENAME identity_file = "./data/identity.csv";

    // 1. Load Transactions and Customers
    LOAD transactions_file 
        TO VERTEX Transaction VALUES(
            $"TransactionID", $"TransactionDT", $"TransactionAmt", $"ProductCD", 
            $"card1", $"card2", $"card3", $"card4", $"card5", $"card6", 
            $"addr1", $"addr2", $"dist1", $"dist2", 
            $"P_emaildomain", $"R_emaildomain", $"isFraud"
        ),
        // For simplicity, treating the card combinations as a unique customer proxy if no CustomerID exists
        TO VERTEX Customer VALUES($"card1", $"P_emaildomain"),
        TO EDGE MADE_TRANSACTION VALUES($"card1", $"TransactionID")
        USING SEPARATOR=",", HEADER="true", EOL="\n", QUOTE="double";

    // 2. Load Devices, IPs, and Identity linkages
    LOAD identity_file
        TO VERTEX Device VALUES($"id_31", $"DeviceType", $"DeviceInfo"), // id_31 often contains browser/device
        TO VERTEX IPAddress VALUES($"id_33"), // Assuming id_33 represents IP/Resolution or proxy for it
        TO EDGE HAS_DEVICE VALUES($"TransactionID", $"id_31"),
        TO EDGE FROM_IP VALUES($"TransactionID", $"id_33")
        USING SEPARATOR=",", HEADER="true", EOL="\n", QUOTE="double";
}

// Execute the loading job (uncomment when running)
// RUN LOADING JOB load_fraud_data
